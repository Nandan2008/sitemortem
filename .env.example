# ---------------------------------------------------------------------------------------------
# SiteMortem configuration. Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# ---------------------------------------------------------------------------------------------

# demo = scripted fixes for the bundled demo site (no keys needed); live = real NVIDIA Nemotron calls.
# This is only the default selection in the UI; the user can switch per run if a key is configured.
SITEMEDIC_MODE=demo

# Nebius Token Factory key (https://tokenfactory.nebius.com). Required for live mode.
NEBIUS_API_KEY=
# Leave empty to use https://api.tokenfactory.nebius.com/v1/
NEBIUS_BASE_URL=

# Exact model IDs (run `python scripts/list_models.py`). If empty SiteMortem auto-picks by name, and it
# STOPS with an error if it cannot find all three tiers. It never substitutes one tier for another.
NEMOTRON_NANO_MODEL=
NEMOTRON_SUPER_MODEL=
NEMOTRON_ULTRA_MODEL=

# How reasoning mode is switched on for Ultra: system (default, Nemotron's "detailed thinking on" system prompt),
# effort (sends reasoning_effort), or off. Run `python scripts/live_check.py` to see what your models accept.
NEMOTRON_REASONING_MODE=system
# Per-request timeout in seconds
NEBIUS_TIMEOUT=90

# Tavily key (https://tavily.com). Optional: without it, search guidance is skipped and reported as skipped.
TAVILY_API_KEY=

# Limits (defaults shown)
SITEMEDIC_RUN_TIMEOUT=900
SITEMEDIC_LIVE_RUNS_PER_HOUR=20
